# Keep vendored file hashes unchanged even with Windows core.autocrlf enabled.
/third_party/MuseTalk/** -text
/install.sh text eol=lf
/start.sh text eol=lf
/scripts/*.sh text eol=lf
/install.bat text eol=crlf
/start.bat text eol=crlf
/install.ps1 text eol=crlf
/start.ps1 text eol=crlf
/scripts/windows_common.ps1 text eol=crlf
/scripts/smoke_musetalk.ps1 text eol=crlf
